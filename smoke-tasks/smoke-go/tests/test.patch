+package main
+
+import "testing"
+
+// TestGreetHello is the fail-to-pass check: greet must return exactly
+// "Hello world!" once the task is solved.
+func TestGreetHello(t *testing.T) {
+	if got := greet(); got != "Hello world!" {
+		t.Fatalf("greet() = %q, want %q", got, "Hello world!")
+	}
+}
