@@ -0,0 +1,77 @@
+using System.Text.Json;
+using Wharf.State;
+
+namespace Wharf.Image;
+
+public sealed class FileImagePullTelemetry : IImagePullTelemetry
+{
+    private readonly string eventsPath;
+    private readonly string summaryPath;
+    private readonly SemaphoreSlim writerLock = new(1, 1);
+    private readonly Dictionary<string, ImagePullResult> images = new(StringComparer.Ordinal);
+    private int totalRateLimits;
+    private long cumulativeDelay;
+
+    public FileImagePullTelemetry(string directory)
+    {
+        if (string.IsNullOrWhiteSpace(directory))
+        {
+            throw new ArgumentException("telemetry directory must not be empty", nameof(directory));
+        }
+
+        Directory.CreateDirectory(directory);
+        eventsPath = Path.Combine(directory, "image-pulls.jsonl");
+        summaryPath = Path.Combine(directory, "image-pull-summary.json");
+    }
+
+    public async Task RecordRateLimitAsync(
+        ImageRateLimitEvent rateLimitEvent,
+        CancellationToken cancellationToken)
+    {
+        await writerLock.WaitAsync(cancellationToken);
+        try
+        {
+            string line = JsonSerializer.Serialize(rateLimitEvent, StateJson.Options) + Environment.NewLine;
+            await using var stream = new FileStream(
+                eventsPath,
+                FileMode.Append,
+                FileAccess.Write,
+                FileShare.Read,
+                4096,
+                FileOptions.Asynchronous);
+            await using var writer = new StreamWriter(stream);
+            await writer.WriteAsync(line.AsMemory(), cancellationToken);
+            await writer.FlushAsync(cancellationToken);
+            stream.Flush(true);
+            totalRateLimits++;
+            cumulativeDelay += rateLimitEvent.RetryDelayMilliseconds;
+        }
+        finally
+        {
+            writerLock.Release();
+        }
+    }
+
+    public async Task RecordResultAsync(
+        ImagePullResult result,
+        CancellationToken cancellationToken)
+    {
+        await writerLock.WaitAsync(cancellationToken);
+        try
+        {
+            images[result.Image] = result;
+            var summary = new ImagePullSummary(
+                ImagePullSchema.Version,
+                totalRateLimits,
+                images.Values.Count(item => item.RateLimitResponses > 0),
+                images.Values.Count(item => item.Outcome == "exhausted"),
+                cumulativeDelay,
+                new Dictionary<string, ImagePullResult>(images, StringComparer.Ordinal));
+            AtomicFile.Replace(summaryPath, JsonSerializer.Serialize(summary, StateJson.Options));
+        }
+        finally
+        {
+            writerLock.Release();
+        }
+    }
+}
diff --git a/src/wharf/Image/ImagePullContracts.cs b/src/wharf/Image/ImagePullContracts.cs
new file mode 100644
index 0000000..6c82308
--- /dev/null
+++ b/src/wharf/Image/ImagePullContracts.cs
@@ -0,0 +1,144 @@
+using System.Text.Json.Serialization;
+
+namespace Wharf.Image;
+
+public static class ImagePullSchema
+{
+    public const string Version = "1.0";
+}
+
+public sealed record ImagePullOptions(
+    int MaximumAttempts = 5,
+    TimeSpan? InitialRetryDelay = null,
+    TimeSpan? MaximumRetryDelay = null,
+    double JitterRatio = 0.2)
+{
+    public TimeSpan InitialDelay => InitialRetryDelay ?? TimeSpan.FromSeconds(1);
+    public TimeSpan MaximumDelay => MaximumRetryDelay ?? TimeSpan.FromSeconds(30);
+
+    public void Validate()
+    {
+        if (MaximumAttempts < 1)
+        {
+            throw new ArgumentOutOfRangeException(nameof(MaximumAttempts), "maximum attempts must be positive");
+        }
+
+        if (InitialDelay <= TimeSpan.Zero || MaximumDelay < InitialDelay)
+        {
+            throw new ArgumentOutOfRangeException(
+                nameof(InitialRetryDelay),
+                "retry delays must be positive and the maximum must not be less than the initial delay");
+        }
+
+        if (JitterRatio is < 0 or > 1)
+        {
+            throw new ArgumentOutOfRangeException(nameof(JitterRatio), "jitter ratio must be between zero and one");
+        }
+    }
+}
+
+public sealed record ImagePullAttempt(bool Succeeded, string StandardOutput, string StandardError);
+
+public sealed record ImagePullResult(
+    string Image,
+    string Registry,
+    string Outcome,
+    int PullAttempts,
+    int RateLimitResponses,
+    long CumulativeRetryDelayMilliseconds,
+    string? Error = null);
+
+public sealed record ImageRateLimitEvent(
+    [property: JsonPropertyName("schemaVersion")] string SchemaVersion,
+    string Registry,
+    string Image,
+    int Attempt,
+    long RetryDelayMilliseconds,
+    string Outcome);
+
+public sealed record ImagePullSummary(
+    [property: JsonPropertyName("schemaVersion")] string SchemaVersion,
+    int TotalRateLimitResponses,
+    int AffectedImages,
+    int ExhaustedRetries,
+    long CumulativeRetryDelayMilliseconds,
+    IReadOnlyDictionary<string, ImagePullResult> Images);
+
+public interface IImageClient
+{
+    Task<bool> ExistsAsync(string image, CancellationToken cancellationToken);
+    Task<ImagePullAttempt> PullAsync(string image, CancellationToken cancellationToken);
+}
+
+public interface IAsyncDelay
+{
+    Task DelayAsync(TimeSpan delay, CancellationToken cancellationToken);
+}
+
+public interface IRandomSource
+{
+    double NextDouble();
+}
+
+public interface IImagePullTelemetry
+{
+    Task RecordRateLimitAsync(ImageRateLimitEvent rateLimitEvent, CancellationToken cancellationToken);
+    Task RecordResultAsync(ImagePullResult result, CancellationToken cancellationToken);
+}
+
+public interface IImagePullConsole
+{
+    void RateLimitRetry(ImageRateLimitEvent rateLimitEvent);
+    void RateLimitSummary(ImagePullResult result);
+}
+
+public sealed class ImagePullException(ImagePullResult result)
+    : Exception($"image pull failed for {result.Image}: {result.Error}")
+{
+    public ImagePullResult Result { get; } = result;
+}
+
+public sealed class DockerImageException(string message) : Exception(message);
+
+public sealed class SystemAsyncDelay : IAsyncDelay
+{
+    public Task DelayAsync(TimeSpan delay, CancellationToken cancellationToken) =>
+        Task.Delay(delay, cancellationToken);
+}
+
+public sealed class SystemRandomSource : IRandomSource
+{
+    public double NextDouble() => Random.Shared.NextDouble();
+}
+
+public sealed class NullImagePullTelemetry : IImagePullTelemetry
+{
+    public Task RecordRateLimitAsync(
+        ImageRateLimitEvent rateLimitEvent,
+        CancellationToken cancellationToken) => Task.CompletedTask;
+
+    public Task RecordResultAsync(
+        ImagePullResult result,
+        CancellationToken cancellationToken) => Task.CompletedTask;
+}
+
+public sealed class ImagePullConsole(int verbosity, bool quiet = false) : IImagePullConsole
+{
+    public void RateLimitRetry(ImageRateLimitEvent rateLimitEvent)
+    {
+        if (!quiet && verbosity >= 2)
+        {
+            Console.Error.WriteLine(
+                $"WARN\tregistry 429\timage={rateLimitEvent.Image}\tattempt={rateLimitEvent.Attempt}\tdelayMs={rateLimitEvent.RetryDelayMilliseconds}\toutcome={rateLimitEvent.Outcome}");
+        }
+    }
+
+    public void RateLimitSummary(ImagePullResult result)
+    {
+        if (!quiet)
+        {
+            Console.Error.WriteLine(
+                $"WARN\tregistry rate limit\timage={result.Image}\tresponses={result.RateLimitResponses}\tdelayMs={result.CumulativeRetryDelayMilliseconds}\toutcome={result.Outcome}");
+        }
+    }
+}
diff --git a/src/wharf/Image/ImagePullCoordinator.cs b/src/wharf/Image/ImagePullCoordinator.cs
new file mode 100644
index 0000000..dc2dca2
--- /dev/null
+++ b/src/wharf/Image/ImagePullCoordinator.cs
@@ -0,0 +1,204 @@
+using System.Collections.Concurrent;
+using System.Text.RegularExpressions;
+
+namespace Wharf.Image;
+
+public sealed partial class ImagePullCoordinator
+{
+    private readonly IImageClient client;
+    private readonly IAsyncDelay delay;
+    private readonly IRandomSource random;
+    private readonly IImagePullTelemetry telemetry;
+    private readonly IImagePullConsole console;
+    private readonly ImagePullOptions options;
+    private readonly ConcurrentDictionary<string, Lazy<Task<ImagePullResult>>> pulls =
+        new(StringComparer.Ordinal);
+    private readonly ConcurrentDictionary<string, int> registryPressure =
+        new(StringComparer.OrdinalIgnoreCase);
+
+    public ImagePullCoordinator(
+        IImageClient client,
+        IAsyncDelay delay,
+        IRandomSource random,
+        IImagePullTelemetry telemetry,
+        IImagePullConsole console,
+        ImagePullOptions? options = null)
+    {
+        this.client = client;
+        this.delay = delay;
+        this.random = random;
+        this.telemetry = telemetry;
+        this.console = console;
+        this.options = options ?? new ImagePullOptions();
+        this.options.Validate();
+    }
+
+    public Task<ImagePullResult> PrepareAsync(
+        string image,
+        CancellationToken cancellationToken = default)
+    {
+        string normalized = NormalizeImage(image);
+        Lazy<Task<ImagePullResult>> pending = pulls.GetOrAdd(
+            normalized,
+            key => new Lazy<Task<ImagePullResult>>(
+                () => PrepareCoreAsync(key, cancellationToken),
+                LazyThreadSafetyMode.ExecutionAndPublication));
+        return pending.Value;
+    }
+
+    public static bool IsRateLimitFailure(ImagePullAttempt attempt)
+    {
+        string failure = $"{attempt.StandardError}\n{attempt.StandardOutput}";
+        return Http429Regex().IsMatch(failure) ||
+            failure.Contains("toomanyrequests", StringComparison.OrdinalIgnoreCase) ||
+            failure.Contains("too many requests", StringComparison.OrdinalIgnoreCase) ||
+            failure.Contains("pull rate limit", StringComparison.OrdinalIgnoreCase) ||
+            failure.Contains("rate limit exceeded", StringComparison.OrdinalIgnoreCase);
+    }
+
+    public static string GetRegistry(string image)
+    {
+        string firstComponent = image.Split('/', 2)[0];
+        bool hasRegistryPath = image.Contains('/', StringComparison.Ordinal);
+        return hasRegistryPath && (
+            firstComponent.Contains('.', StringComparison.Ordinal) ||
+            firstComponent.Contains(':', StringComparison.Ordinal) ||
+            firstComponent.Equals("localhost", StringComparison.OrdinalIgnoreCase)
+        ) ? firstComponent
+            : "docker.io";
+    }
+
+    private async Task<ImagePullResult> PrepareCoreAsync(
+        string image,
+        CancellationToken cancellationToken)
+    {
+        string registry = GetRegistry(image);
+        if (await client.ExistsAsync(image, cancellationToken))
+        {
+            var local = new ImagePullResult(image, registry, "local", 0, 0, 0);
+            await telemetry.RecordResultAsync(local, cancellationToken);
+            return local;
+        }
+
+        int rateLimits = 0;
+        long cumulativeDelay = 0;
+        for (int attempt = 1; attempt <= options.MaximumAttempts; attempt++)
+        {
+            ImagePullAttempt pull = await client.PullAsync(image, cancellationToken);
+            if (pull.Succeeded)
+            {
+                DecayPressure(registry);
+                var succeeded = new ImagePullResult(
+                    image,
+                    registry,
+                    "pulled",
+                    attempt,
+                    rateLimits,
+                    cumulativeDelay);
+                await CompleteAsync(succeeded, cancellationToken);
+                return succeeded;
+            }
+
+            if (!IsRateLimitFailure(pull))
+            {
+                var failed = new ImagePullResult(
+                    image,
+                    registry,
+                    "failed",
+                    attempt,
+                    rateLimits,
+                    cumulativeDelay,
+                    SelectError(pull));
+                await CompleteAsync(failed, cancellationToken);
+                throw new ImagePullException(failed);
+            }
+
+            rateLimits++;
+            int pressure = registryPressure.AddOrUpdate(
+                registry,
+                1,
+                static (_, current) => Math.Min(current + 1, 30));
+            bool exhausted = attempt == options.MaximumAttempts;
+            TimeSpan selectedDelay = exhausted
+                ? TimeSpan.Zero
+                : SelectDelay(Math.Max(rateLimits, pressure));
+            cumulativeDelay += (long)selectedDelay.TotalMilliseconds;
+            var rateLimitEvent = new ImageRateLimitEvent(
+                ImagePullSchema.Version,
+                registry,
+                image,
+                attempt,
+                (long)selectedDelay.TotalMilliseconds,
+                exhausted ? "exhausted" : "retrying");
+            await telemetry.RecordRateLimitAsync(rateLimitEvent, cancellationToken);
+            console.RateLimitRetry(rateLimitEvent);
+
+            if (exhausted)
+            {
+                var failed = new ImagePullResult(
+                    image,
+                    registry,
+                    "exhausted",
+                    attempt,
+                    rateLimits,
+                    cumulativeDelay,
+                    SelectError(pull));
+                await CompleteAsync(failed, cancellationToken);
+                throw new ImagePullException(failed);
+            }
+
+            await delay.DelayAsync(selectedDelay, cancellationToken);
+        }
+
+        throw new InvalidOperationException("image pull retry loop ended unexpectedly");
+    }
+
+    private async Task CompleteAsync(ImagePullResult result, CancellationToken cancellationToken)
+    {
+        await telemetry.RecordResultAsync(result, cancellationToken);
+        if (result.RateLimitResponses > 0)
+        {
+            console.RateLimitSummary(result);
+        }
+    }
+
+    private TimeSpan SelectDelay(int pressure)
+    {
+        double milliseconds = options.InitialDelay.TotalMilliseconds;
+        for (int exponent = 1; exponent < pressure; exponent++)
+        {
+            milliseconds = Math.Min(milliseconds * 2, options.MaximumDelay.TotalMilliseconds);
+        }
+
+        double jitter = 1 + (((random.NextDouble() * 2) - 1) * options.JitterRatio);
+        return TimeSpan.FromMilliseconds(Math.Min(
+            milliseconds * jitter,
+            options.MaximumDelay.TotalMilliseconds));
+    }
+
+    private void DecayPressure(string registry)
+    {
+        registryPressure.AddOrUpdate(
+            registry,
+            0,
+            static (_, current) => Math.Max(0, current - 1));
+    }
+
+    private static string NormalizeImage(string image)
+    {
+        if (string.IsNullOrWhiteSpace(image))
+        {
+            throw new ArgumentException("image reference must not be empty", nameof(image));
+        }
+
+        return image.Trim();
+    }
+
+    private static string SelectError(ImagePullAttempt attempt) =>
+        string.IsNullOrWhiteSpace(attempt.StandardError)
+            ? attempt.StandardOutput.Trim()
+            : attempt.StandardError.Trim();
+
+    [GeneratedRegex(@"(?:^|\D)429(?:\D|$)", RegexOptions.CultureInvariant)]
+    private static partial Regex Http429Regex();
+}
