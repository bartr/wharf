+using Wharf.Copilot;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public async Task AddsCopilotAdapterBoundary()
+    {
+        var adapter = new CopilotAdapter(new StaticProbe("v1.2.3"));
+        var options = Options(
+            new CopilotCredentialSource(CopilotCredentialSourceKind.Stdin, "stdin"));
+
+        CopilotInvocation invocation = await adapter.PrepareAsync(options);
+
+        Assert.Equal("1.2.3", invocation.EffectiveVersion);
+        Assert.Equal("high", invocation.FrontierEffort);
+        Assert.True(invocation.ReadsCredentialFromStdin);
+        Assert.Contains("--model", invocation.Arguments);
+        Assert.Contains("--subagent-model", invocation.Arguments);
+        Assert.Contains("--endpoint", invocation.Arguments);
+    }
+
+    [Fact]
+    public async Task AddsCredentialSourceKindsAndValidationTypes()
+    {
+        var adapter = new CopilotAdapter(new StaticProbe("1.2.3"));
+        var credential = new CopilotCredentialSource(
+            CopilotCredentialSourceKind.Environment,
+            "COPILOT_TOKEN");
+
+        CopilotInvocation invocation = await adapter.PrepareAsync(Options(credential));
+
+        Assert.Equal("environment", invocation.Environment["WHARF_COPILOT_CREDENTIAL_SOURCE"]);
+        Assert.Equal("COPILOT_TOKEN", invocation.Environment["WHARF_COPILOT_CREDENTIAL_VARIABLE"]);
+        Assert.DoesNotContain("secret-value", invocation.RedactedCommand);
+        Assert.Throws<ArgumentException>(
+            () => new CopilotCredentialSource(
+                CopilotCredentialSourceKind.Environment,
+                "BAD-NAME").Validate());
+    }
+
+    [Fact]
+    public async Task InvocationCarriesEffectiveVersionAndRedactedCommand()
+    {
+        var adapter = new CopilotAdapter(new StaticProbe("1.2.4"));
+
+        await Assert.ThrowsAsync<CopilotAdapterException>(
+            () => adapter.PrepareAsync(Options(
+                new CopilotCredentialSource(CopilotCredentialSourceKind.Stdin, "stdin"))));
+    }
+
+    private static CopilotAdapterOptions Options(CopilotCredentialSource credential) =>
+        new(
+            "1.2.3",
+            "gpt-test",
+            "high",
+            "xhigh",
+            ["subagent"],
+            credential,
+            ["https://api.example.test/v1"],
+            new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+            {
+                "api.example.test"
+            });
+
+    private sealed class StaticProbe(string version) : ICopilotCliProbe
+    {
+        public Task<CopilotCliVersion> GetVersionAsync(
+            CancellationToken cancellationToken) =>
+            Task.FromResult(new CopilotCliVersion(version));
+    }
+}
