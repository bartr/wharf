+using System.Text.Json;
+using Wharf.Verifier;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public async Task AddsVerifierContractsAndSchema()
+    {
+        using var source = new TemporaryDirectory();
+        using var agent = new TemporaryDirectory();
+        using var verifier = new TemporaryDirectory();
+        using var evidence = new TemporaryDirectory();
+        var runner = new RecordingRunner(
+            new VerifierCommandResult("first", 1, "out", "err", 5, false));
+        var service = new PristineVerifierService(
+            new StaticWorkspaceFactory(verifier.Path),
+            new RecordingPatchApplier(),
+            runner);
+
+        TrialResult result = await service.VerifyAsync(
+            Request(source.Path, agent.Path),
+            "patch",
+            evidence.Path);
+
+        Assert.Equal("1.0", result.SchemaVersion);
+        Assert.Equal("failed", result.Status);
+        Assert.Single(result.Commands);
+        Assert.Single(runner.Commands);
+        Assert.True(File.Exists(Path.Combine(evidence.Path, "trial-result.json")));
+        Assert.True(File.Exists(Path.Combine(evidence.Path, "first.stdout.log")));
+    }
+
+    [Fact]
+    public void RejectsAgentWorkspaceReuse()
+    {
+        using var source = new TemporaryDirectory();
+        VerifierRequest request = Request(source.Path, source.Path);
+
+        Assert.Throws<VerifierExecutionException>(request.Validate);
+    }
+
+    [Fact]
+    public void RejectsMalformedCredentialEnvironmentNames()
+    {
+        using var source = new TemporaryDirectory();
+        using var agent = new TemporaryDirectory();
+        VerifierRequest request = Request(source.Path, agent.Path, ["BAD-NAME"]);
+
+        Assert.Throws<VerifierExecutionException>(request.Validate);
+    }
+
+    [Fact]
+    public async Task ExposesPristineVerificationService()
+    {
+        using var source = new TemporaryDirectory();
+        using var agent = new TemporaryDirectory();
+        using var verifier = new TemporaryDirectory();
+        using var evidence = new TemporaryDirectory();
+        var factory = new StaticWorkspaceFactory(verifier.Path);
+        var service = new PristineVerifierService(
+            factory,
+            new RecordingPatchApplier(),
+            new RecordingRunner());
+
+        await Assert.ThrowsAsync<VerifierExecutionException>(
+            () => service.VerifyAsync(
+                Request(source.Path, agent.Path),
+                "",
+                evidence.Path));
+
+        Assert.Equal(0, factory.Calls);
+        Assert.False(File.Exists(Path.Combine(evidence.Path, "trial-result.json")));
+    }
+
+    private static VerifierRequest Request(
+        string source,
+        string agent,
+        IReadOnlyList<string>? credentials = null) =>
+        new(
+            "task",
+            source,
+            agent,
+            "network",
+            [
+                new VerifierCommand("first", "first", TimeSpan.FromSeconds(1)),
+                new VerifierCommand("second", "second", TimeSpan.FromSeconds(1))
+            ],
+            [],
+            credentials ?? ["VERIFIER_TOKEN"]);
+
+    private sealed class StaticWorkspaceFactory(string path)
+        : IPristineWorkspaceFactory
+    {
+        public int Calls { get; private set; }
+
+        public Task<string> CreateAsync(
+            string sourceDirectory,
+            CancellationToken cancellationToken)
+        {
+            Calls++;
+            return Task.FromResult(path);
+        }
+    }
+
+    private sealed class RecordingPatchApplier : IPatchApplier
+    {
+        public Task ApplyAsync(
+            string workspaceDirectory,
+            string patch,
+            CancellationToken cancellationToken) => Task.CompletedTask;
+    }
+
+    private sealed class RecordingRunner(params VerifierCommandResult[] results)
+        : IVerifierRunner
+    {
+        public List<string> Commands { get; } = [];
+
+        public Task<VerifierCommandResult> RunAsync(
+            VerifierRequest request,
+            string workspaceDirectory,
+            VerifierCommand command,
+            CancellationToken cancellationToken)
+        {
+            Commands.Add(command.Name);
+            VerifierCommandResult result = results.Length >= Commands.Count
+                ? results[Commands.Count - 1]
+                : new VerifierCommandResult(command.Name, 0, "", "", 1, false);
+            return Task.FromResult(result);
+        }
+    }
+
+    private sealed class TemporaryDirectory : IDisposable
+    {
+        public TemporaryDirectory()
+        {
+            Path = System.IO.Path.Combine(
+                System.IO.Path.GetTempPath(),
+                Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(Path);
+        }
+
+        public string Path { get; }
+
+        public void Dispose() => Directory.Delete(Path, recursive: true);
+    }
+}
