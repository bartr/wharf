+using System.Diagnostics;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public void AddsPackagingScriptsWithSupplyChainControls()
+    {
+        string root = FindRoot();
+        string[] scripts =
+        [
+            "scripts/package-wharf.sh",
+            "scripts/wharf-bootstrap.sh",
+            "scripts/wharf-rollback.sh"
+        ];
+
+        foreach (string script in scripts)
+        {
+            string path = Path.Combine(root, script);
+            Assert.True(File.Exists(path), $"missing {script}");
+            ProcessResult syntax = Run("bash", ["-n", path], root);
+            Assert.Equal(0, syntax.ExitCode);
+        }
+    }
+
+    [Fact]
+    public void KeepsPrivilegeAndRollbackBoundariesExplicit()
+    {
+        string root = FindRoot();
+        string package = Path.Combine(root, "scripts/package-wharf.sh");
+        string bootstrap = Path.Combine(root, "scripts/wharf-bootstrap.sh");
+
+        ProcessResult invalidVersion = Run("bash", [package, "not-a-version"], root);
+        ProcessResult missingPackage = Run(
+            "bash",
+            [bootstrap, Path.Combine(root, "missing.deb")],
+            root);
+
+        Assert.NotEqual(0, invalidVersion.ExitCode);
+        Assert.NotEqual(0, missingPackage.ExitCode);
+        Assert.Contains("usage:", invalidVersion.StandardError);
+        Assert.Contains("usage:", missingPackage.StandardError);
+    }
+
+    [Fact]
+    public void PreservesExistingReleaseAssembly()
+    {
+        string package = File.ReadAllText(
+            Path.Combine(FindRoot(), "scripts/package-wharf.sh"));
+
+        Assert.Contains("\"bomFormat\": \"CycloneDX\"", package);
+        Assert.Contains("sort_keys=True", package);
+        Assert.Contains("--detach-sign", package);
+        Assert.Contains("--verify", package);
+    }
+
+    private static string FindRoot()
+    {
+        string? current = AppContext.BaseDirectory;
+        while (current is not null &&
+               !File.Exists(Path.Combine(current, "wharf.slnx")))
+        {
+            current = Directory.GetParent(current)?.FullName;
+        }
+
+        return current ?? throw new InvalidOperationException("repository root not found");
+    }
+
+    private static ProcessResult Run(
+        string fileName,
+        IReadOnlyList<string> arguments,
+        string workingDirectory)
+    {
+        var start = new ProcessStartInfo(fileName)
+        {
+            WorkingDirectory = workingDirectory,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false
+        };
+        foreach (string argument in arguments)
+            start.ArgumentList.Add(argument);
+        using Process process = Process.Start(start)!;
+        string stdout = process.StandardOutput.ReadToEnd();
+        string stderr = process.StandardError.ReadToEnd();
+        process.WaitForExit();
+        return new ProcessResult(process.ExitCode, stdout, stderr);
+    }
+
+    private sealed record ProcessResult(
+        int ExitCode,
+        string StandardOutput,
+        string StandardError);
+}
