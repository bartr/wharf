+using Wharf.Execution;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public void AddsHistoricalContracts()
+    {
+        var limits = new PhaseResourceLimits(1, 2, 3);
+        var timeouts = new PhaseTimeoutPolicy(
+            TimeSpan.FromSeconds(1),
+            TimeSpan.FromSeconds(2),
+            TimeSpan.FromSeconds(3),
+            2,
+            new Dictionary<ExecutionPhase, TimeSpan>
+            {
+                [ExecutionPhase.Agent] = TimeSpan.FromSeconds(4)
+            });
+
+        Assert.Equal(3, limits.For(ExecutionPhase.Verifier));
+        Assert.Equal(TimeSpan.FromSeconds(8), timeouts.For(ExecutionPhase.Agent));
+    }
+
+    [Fact]
+    public async Task ExposesExpectedBoundaryOperations()
+    {
+        await using var service = new PhaseExecutionService(
+            new PhaseResourceLimits(1, 1, 1),
+            new PhaseTimeoutPolicy(
+                TimeSpan.FromSeconds(5),
+                TimeSpan.FromSeconds(5),
+                TimeSpan.FromSeconds(5)),
+            new InfrastructureRetryPolicy(1));
+        int calls = 0;
+
+        PhaseExecutionResult<string> result = await service.ExecuteAsync(
+            "logical-1",
+            ExecutionPhase.Agent,
+            _ =>
+            {
+                calls++;
+                return calls == 1
+                    ? Task.FromException<string>(new IOException("transient"))
+                    : Task.FromResult("ok");
+            },
+            exception => exception is IOException);
+
+        Assert.Equal("ok", result.Value);
+        Assert.Equal(1, result.InfrastructureRetries);
+        Assert.Equal(2, calls);
+    }
+
+    [Fact]
+    public void PreservesExistingReleaseAssembly()
+    {
+        var limits = new PhaseResourceLimits(1, 0, 1);
+        var retries = new InfrastructureRetryPolicy(-1);
+
+        Assert.Throws<ArgumentOutOfRangeException>(limits.Validate);
+        Assert.Throws<ArgumentOutOfRangeException>(retries.Validate);
+    }
+}
