+using Wharf.Image;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public async Task AddsDerivedImageCoordinatorBoundary()
+    {
+        var backend = new RecordingBackend();
+        await using var coordinator = new DerivedImageCoordinator(backend, 1);
+        DerivedImageRequest request = Request();
+
+        DerivedImageResult first = await coordinator.PrepareAsync(request);
+        DerivedImageResult second = await coordinator.PrepareAsync(request);
+
+        Assert.False(first.Reused);
+        Assert.True(second.Reused);
+        Assert.Equal(1, backend.Builds);
+        Assert.Equal(first.CacheKey, second.CacheKey);
+    }
+
+    [Fact]
+    public void ExposesDeterministicDerivedImageCacheKey()
+    {
+        DerivedImageRequest first = Request(
+            versions: new Dictionary<string, string>
+            {
+                ["b"] = "2",
+                ["a"] = "1"
+            });
+        DerivedImageRequest second = Request(
+            versions: new Dictionary<string, string>
+            {
+                ["a"] = "1",
+                ["b"] = "2"
+            });
+        DerivedImageRequest reorderedScripts = first with
+        {
+            Scripts = ["second", "first"]
+        };
+
+        Assert.Equal(
+            DerivedImageCacheKey.Create(first),
+            DerivedImageCacheKey.Create(second));
+        Assert.NotEqual(
+            DerivedImageCacheKey.Create(first),
+            DerivedImageCacheKey.Create(reorderedScripts));
+    }
+
+    [Fact]
+    public void RejectsInvalidDerivedImageRequests()
+    {
+        var request = new DerivedImageRequest(
+            "",
+            ["script"],
+            new Dictionary<string, string>(),
+            new Dictionary<string, string>());
+
+        Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    private static DerivedImageRequest Request(
+        IReadOnlyDictionary<string, string>? versions = null) =>
+        new(
+            "base:latest",
+            ["first", "second"],
+            versions ?? new Dictionary<string, string>(),
+            new Dictionary<string, string>
+            {
+                ["mode"] = "test"
+            });
+
+    private sealed class RecordingBackend : IDerivedImageBackend
+    {
+        public int Builds { get; private set; }
+
+        public Task EnsureBaseImageAsync(
+            string image,
+            CancellationToken cancellationToken) => Task.CompletedTask;
+
+        public Task PrepareContextAsync(
+            DerivedImageRequest request,
+            string cacheKey,
+            CancellationToken cancellationToken) => Task.CompletedTask;
+
+        public Task<string> BuildAsync(
+            DerivedImageRequest request,
+            string cacheKey,
+            CancellationToken cancellationToken)
+        {
+            Builds++;
+            return Task.FromResult($"derived:{cacheKey}");
+        }
+    }
+}
