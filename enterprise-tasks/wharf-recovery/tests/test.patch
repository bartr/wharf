+using Wharf.Recovery;
+using Wharf.State;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public async Task AddsHistoricalContracts()
+    {
+        string eventsPath = TemporaryEventStream();
+        var attempts = new[]
+        {
+            new RecoveryAttempt("b", "logical-b", "trial-b"),
+            new RecoveryAttempt("a", "logical-a", "trial-a")
+        };
+
+        RecoveryPlan plan = await new RunRecoveryPlanner().PlanAsync(
+            new RunId("run-1"),
+            eventsPath,
+            attempts);
+
+        Assert.Equal(["a", "b"], plan.AttemptsToResume.Select(item => item.AttemptId));
+    }
+
+    [Fact]
+    public async Task ExposesExpectedBoundaryOperations()
+    {
+        string eventsPath = TemporaryEventStream();
+        var resources = new StaticResources("trial-known", "orphan");
+        var attempts = new[]
+        {
+            new RecoveryAttempt("a", "logical-a", "trial-known")
+        };
+
+        RecoveryPlan plan = await new RunRecoveryPlanner(resources).PlanAsync(
+            new RunId("run-1"),
+            eventsPath,
+            attempts);
+
+        Assert.Equal(["orphan"], plan.OrphanedResourceIds);
+    }
+
+    [Fact]
+    public async Task PreservesExistingReleaseAssembly()
+    {
+        string eventsPath = TemporaryEventStream();
+
+        RecoveryPlan plan = await new RunRecoveryPlanner().PlanAsync(
+            new RunId("run-1"),
+            eventsPath,
+            []);
+
+        Assert.Empty(plan.AttemptsToResume);
+        Assert.Empty(plan.InfrastructureRetryCounts);
+        Assert.Empty(plan.CompletedLogicalAttempts);
+    }
+
+    private static string TemporaryEventStream()
+    {
+        string path = Path.GetTempFileName();
+        File.WriteAllText(path, string.Empty);
+        return path;
+    }
+
+    private sealed class StaticResources(params string[] resourceIds)
+        : ILiveResourceReconciler
+    {
+        public Task<LiveResourceSnapshot> InspectAsync(
+            RunId runId,
+            CancellationToken cancellationToken) =>
+            Task.FromResult(new LiveResourceSnapshot(
+                resourceIds.ToHashSet(StringComparer.Ordinal)));
+    }
+}
