+using Wharf.Audit;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public void AddsHistoricalContracts()
+    {
+        AuditReport report = new AuditScorer().Score(
+            new AuditRun("run", ["task"], [new AuditTask("task", [Attempt()])]));
+
+        Assert.Equal(1, report.PassAt1);
+        Assert.Equal(60, report.EnterpriseScore);
+        Assert.True(report.Completeness.IsComplete);
+        Assert.Null(report.Cost);
+    }
+
+    [Fact]
+    public void ExposesExpectedBoundaryOperations()
+    {
+        AuditAttempt regressed = Attempt() with
+        {
+            NewTestCoverage = Measurement<double>.ValidValue(1),
+            ExistingTestRegression = Measurement<bool>.ValidValue(true)
+        };
+
+        AuditReport report = new AuditScorer().Score(
+            new AuditRun("run", ["task"], [new AuditTask("task", [regressed])]));
+
+        Assert.Equal(0, report.EnterpriseScore);
+        Assert.True(report.ExistingTestRegression);
+    }
+
+    [Fact]
+    public void PreservesExistingReleaseAssembly()
+    {
+        AuditAttempt incomplete = Attempt() with
+        {
+            Cost = Measurement<double>.MissingValue()
+        };
+
+        AuditReport report = new AuditScorer().Score(
+            new AuditRun("run", ["task"], [new AuditTask("task", [incomplete])]));
+
+        Assert.Null(report.Cost);
+        Assert.False(report.Completeness.IsComplete);
+        Assert.Equal(1, report.Completeness.MissingMeasurements);
+    }
+
+    private static AuditAttempt Attempt() => new(
+        "attempt-1",
+        1,
+        Measurement<bool>.ValidValue(true),
+        Measurement<double>.ValidValue(0.5),
+        Measurement<bool>.ValidValue(false),
+        Measurement<double>.ZeroValue(),
+        Measurement<long>.ZeroValue(),
+        Measurement<long>.ZeroValue(),
+        Measurement<long>.ZeroValue(),
+        Measurement<long>.ZeroValue(),
+        Measurement<long>.ZeroValue(),
+        Measurement<TimeSpan>.ValidValue(TimeSpan.Zero),
+        Measurement<TimeSpan>.ValidValue(TimeSpan.Zero));
+}
