+using System.Text.Json;
+using Wharf.Audit;
+using Wharf.Reporting;
+
+namespace Wharf.Tests;
+
+public sealed class DeepSweWharfTests
+{
+    [Fact]
+    public void AddsHistoricalContracts()
+    {
+        var renderer = new ReportRenderer();
+        ReportInput input = Input("run-1", "run-1");
+
+        string first = renderer.RenderJson(input);
+        string second = renderer.RenderJson(input);
+        string jsonLines = renderer.RenderJsonLines(input);
+
+        Assert.Equal(first, second);
+        Assert.EndsWith(Environment.NewLine, jsonLines);
+        Assert.Equal(1, jsonLines.Count(character => character == '\n'));
+    }
+
+    [Fact]
+    public void ExposesExpectedBoundaryOperations()
+    {
+        var renderer = new ReportRenderer();
+
+        Assert.Throws<ReportInputException>(
+            () => renderer.RenderJson(Input("run-1", "different-run")));
+    }
+
+    [Fact]
+    public void PreservesExistingReleaseAssembly()
+    {
+        string markdown = new ReportRenderer().RenderMarkdown(
+            Input("run-1", "run-1"));
+
+        Assert.Contains("PASS@1: `50%`", markdown);
+        Assert.Contains("Cost: `missing`", markdown);
+        Assert.Contains("Infrastructure retries: `2`", markdown);
+        Assert.Contains("HTTP 429 responses: `3`", markdown);
+    }
+
+    private static ReportInput Input(string runId, string auditRunId)
+    {
+        var completeness = new AuditCompleteness(2, 2, 0, 2, 2, 0, 0, 0, 0);
+        var audit = new AuditReport(
+            auditRunId,
+            0.5,
+            75,
+            1,
+            2,
+            0.75,
+            false,
+            null,
+            10,
+            20,
+            30,
+            1,
+            2,
+            TimeSpan.FromSeconds(3),
+            TimeSpan.FromSeconds(4),
+            completeness);
+        return new ReportInput(
+            ReportSchema.Version,
+            runId,
+            JsonDocument.Parse("""{"mode":"test"}""").RootElement,
+            new SortedDictionary<string, string>(),
+            audit,
+            new RetryReport(2, 1, 0),
+            new RateLimitReport(3, 2, 0, 50));
+    }
+}
